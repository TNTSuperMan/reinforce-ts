{
  "name": "reinforcejs",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5.8.3"
  },
  "scripts": {
    "build": "bun build-recurrent && bun build-reinforce",
    "build-recurrent": "bun build --minify --outdir=dist --entry-naming=recurrent.js recurrent/index.ts",
    "build-reinforce": "bun build --minify --outdir=dist --entry-naming=dqn.js reinforce/dqn/index.ts"
  }
}
